<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.TicTacToe.Button"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/ttt_primary</item>
        <item name="android:textColor">@color/ttt_on_primary</item>
    </style>

    <style name="TextAppearance.TicTacToe.Title"
        parent="TextAppearance.Material3.HeadlineLarge">

        <item name="android:textColor">@color/ttt_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TicTacToe.Body"
        parent="TextAppearance.Material3.BodyLarge">

        <item name="android:textColor">@color/ttt_text_secondary</item>
    </style>

    <style name="Widget.TicTacToe.Cell"
        parent="Widget.AppCompat.ImageButton">

        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>

        <item name="android:background">@drawable/bg_game_cell</item>
        <item name="android:padding">20dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:enabled">false</item>
    </style>

</resources>