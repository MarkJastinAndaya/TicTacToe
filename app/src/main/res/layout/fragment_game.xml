<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ttt_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="64dp"
            android:text="@string/countdown_tic"
            android:textColor="@color/ttt_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/turnText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/game_starting"
            android:textColor="@color/ttt_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gameAssignments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.TicTacToe.Body" />

        <GridLayout
            android:id="@+id/gameGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:rowCount="3">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cell0"
                style="@style/Widget.TicTacToe.Cell"
                android:layout_row="0"
                android:layout_column="0" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cell1"
                style="@style/Widget.TicTacToe.Cell"
                android:layout_row="0"
                android:layout_column="1" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cell2"
                style="@style/Widget.TicTacToe.Cell"
                android:layout_row="0"
                android:layout_column="2" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cell3"
                style="@style/Widget.TicTacToe.Cell"
                android:layout_row="1"
                android:layout_column="0" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cell4"
                style="@style/Widget.TicTacToe.Cell"
                android:layout_row="1"
                android:layout_column="1" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cell5"
                style="@style/Widget.TicTacToe.Cell"
                android:layout_row="1"
                android:layout_column="2" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cell6"
                style="@style/Widget.TicTacToe.Cell"
                android:layout_row="2"
                android:layout_column="0" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cell7"
                style="@style/Widget.TicTacToe.Cell"
                android:layout_row="2"
                android:layout_column="1" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cell8"
                style="@style/Widget.TicTacToe.Cell"
                android:layout_row="2"
                android:layout_column="2" />

        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/menuButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_game_cell"
                android:contentDescription="@string/action_home"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/restartButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_game_cell"
                android:contentDescription="@string/action_restart"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_restart" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/surrenderButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_game_cell"
                android:contentDescription="@string/action_surrender"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_surrender" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>